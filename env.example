# Copy this file to .env.development.local (or .env.production.local) and fill in real values.
# Never commit the actual .env files — only this example file should be in version control.

# Server
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# Database (MongoDB Atlas connection string)
DB_URI=

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Arcjet (rate limiting, bot detection, shield)
# Get your key from https://app.arcjet.com
ARCJET_KEY=
ARCJET_ENV=development

# Upstash QStash / Workflow (durable background jobs for renewal reminders)
# Get these from https://console.upstash.com -> QStash
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Email (Nodemailer + Gmail SMTP)
# Use a Gmail App Password, not your normal account password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA enabled)
EMAIL_PASSWORD=
